# Environment Variables Template for Backend

# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/database_name

# JWT Secret (Generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Server Configuration
# PORT is automatically assigned by hosting platforms (Heroku, Railway, AWS, etc.)
# For local development, you can set a custom port (defaults to 4000 if not set)
PORT=4000
NODE_ENV=production

# CORS Origins (Comma-separated list of allowed origins)
CORS_ORIGINS=https://your-amplify-app.amplifyapp.com,https://your-custom-domain.com

# Email Configuration (Outlook)
EMAIL_SERVICE=outlook
EMAIL_USER=your-email@outlook.com
EMAIL_PASS=your-email-password
EMAIL_FROM=your-email@outlook.com

# Optional: Upload Directory
# UPLOAD_DIR=/tmp/uploads

# Optional: Admin Account (for initial setup)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=secure-password
# ADMIN_NAME=System Administrator
