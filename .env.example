# ==============================================================================
# SD Commercial HR CRM - Environment Variables Template
# Copy this file to .env or Backend/.env before running the application
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
JWT_SECRET=your-secure-jwt-secret-key-here
CORS_ORIGIN=http://localhost:3002

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Dedicated parameters:
PGHOST=localhost
PGPORT=5432
PGDATABASE=new_CRM
PGUSER=sdcommercial
PGPASSWORD=your-db-password

# Combined Connection String URL:
DATABASE_URL=postgresql://sdcommercial:your-db-password@localhost:5432/new_CRM

# ------------------------------------------------------------------------------
# Frontend (Vite) Configuration
# ------------------------------------------------------------------------------
VITE_APP_NAME="SD Commercial HR Portal"
VITE_API_URL=http://localhost:4000/api

# ------------------------------------------------------------------------------
# SMTP Email Settings (Handover reports & alerts)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="SD Commercial HR <your-email@example.com>"

# ------------------------------------------------------------------------------
# Security & Integrations (Optional)
# ------------------------------------------------------------------------------
AIKIDO_TOKEN=
GEMINI_API_KEY=
