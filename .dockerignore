# ============================================
# Docker Build Context Exclusions
# ============================================

# Version Control
.git
.gitignore
.github

# Dependencies (Installed cleanly during docker build)
node_modules
**/node_modules
Backend/node_modules
frontend/node_modules

# Build & Dist Artifacts
frontend/dist
dist/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Development & IDE Files
.vscode
.idea
.gemini/
.agents/
.brain/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test & QA Assets
qa/
tests/
*.test.js
*.spec.js

# Documentation
docs/
*.md
!README.md
LICENSE

# Docker Configuration Files (Avoid self-inclusion)
docker-compose*.yml
Dockerfile*
.dockerignore

# Environment Files (Do not leak local secrets into image context)
.env
.env.*
!.env.example

# Local Uploads & Temp Data
Backend/uploads/*
!Backend/uploads/.gitkeep
uploads/
tmp/
temp/

