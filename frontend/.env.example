# Environment Variables Template for Frontend

# API Backend URL (Your backend deployment URL)
# Leave commented for local development (auto-discovery will be used)
# VITE_API_URL=https://your-backend-api.com/api

# Frontend Port Configuration (optional)
# The hosting platform will automatically assign a port if not specified
# For local development, you can set a custom port:
# PORT=3002
# VITE_PORT=3002

# Optional: Enable/disable features
# VITE_ENABLE_ANALYTICS=true
# VITE_APP_VERSION=1.0.0
