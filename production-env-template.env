# Production Environment Variables Template
# Copy this to .env in your production server and update the values

# Environment
NODE_ENV=production

# JWT Configuration - CRITICAL for authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-32-chars-minimum

# CORS Configuration - Add your domain(s)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com

# Frontend URL
FRONTEND_URL=https://yourdomain.com

# Cookie Domain (optional, for cross-subdomain)
COOKIE_DOMAIN=.yourdomain.com

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/hr_crm
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hr_crm
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Email Configuration (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Application Configuration
APP_NAME=SD HR CRM
APP_URL=https://yourdomain.com

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=another-secret-key-for-sessions

# Logging
ACTIVITY_LOGS_ENABLED=true

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
